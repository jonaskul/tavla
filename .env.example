# Copy to .env and fill in. Everything here is read once at startup; see
# config.py, which refuses to start a production deployment that is missing
# anything it cannot work without.

# production turns on the strict checks below. Anything else is development.
TAVLA_ENV=production

# PostgreSQL. Row-level security — the layer that stops one customer's data
# reaching another even if a query forgets its WHERE clause — exists only
# here, not in SQLite.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/tavla

# Keys the sign-in codes and session tokens are derived from. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out and invalidates codes in flight.
SESSION_SECRET=

# Which origins may call the API from a browser. Comma-separated, no
# wildcard: the session is a cookie, and browsers refuse a wildcard when
# credentials are allowed.
#
# Leave EMPTY if the API is served under the same origin as the frontend
# (tavla.digibygg.io/api) — then there is no cross-origin request to allow.
CORS_ORIGINS=https://tavla.digibygg.io

# Sign-in email. Without both of these nobody can sign in, so production
# refuses to start.
RESEND_API_KEY=
AUTH_FROM_EMAIL=Tavla <innlogging@digibygg.io>

# Cookie. The browser decides "same site" by registrable domain, so
# anything under digibygg.io stays "lax" — including tavla.digibygg.io and
# api.tavla.digibygg.io together. Only a split across unrelated domains
# (pages.dev and fly.dev, say) would force "none", which gives up the CSRF
# protection Lax provides.
COOKIE_SECURE=1
COOKIE_SAMESITE=lax
# Leave unset. Host-only is stricter: the cookie then goes only to the host
# that set it, instead of to every subdomain of digibygg.io.
# COOKIE_DOMAIN=

# single_user turns authentication off entirely, for a self-hosted install
# with one user. Never set this on anything reachable from the internet.
AUTH_MODE=session

# Which upstream addresses uvicorn will believe X-Forwarded-For from.
# Defaults to 127.0.0.1, which is right when the API runs on the same host
# as nginx and wrong the moment it runs in a container — the connection then
# arrives from the docker bridge, the header is ignored, and every caller
# looks like the proxy. The sign-in endpoint rate limits per IP, so that
# turns into "nobody can sign in" once ten codes have gone out in an hour.
# Set it to the address nginx actually connects from.
# FORWARDED_ALLOW_IPS=172.17.0.1

LOG_LEVEL=INFO
